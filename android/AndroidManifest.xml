<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.fanfolio"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- syncing from AO3, and fonts for the reader -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup is off deliberately: a detailed record of what someone
         reads is not something to hand to cloud backup without asking. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Opening a work link.

                Not autoVerify: verification needs a Digital Asset Links file
                served from the archive's own domain, which is not ours to
                publish. Android therefore treats these as unverified links,
                which on Android 12 and later means the app is not offered
                until the reader turns it on in Settings → Apps → Open by
                default. That is the honest arrangement for a third-party
                reader, and the app says so on its first run.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!--
                    Every host the archive answers on. Each was checked and
                    every one redirects to archiveofourown.org, but Android
                    matches the link that was tapped rather than the one it
                    ends up at, so all of them have to be named. ao3.org is
                    the one people type by hand and paste into messages;
                    download.* is what the archive's own download links use.
                -->
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="archiveofourown.org" />
                <data android:host="www.archiveofourown.org" />
                <data android:host="ao3.org" />
                <data android:host="www.ao3.org" />
                <data android:host="archiveofourown.com" />
                <data android:host="www.archiveofourown.com" />
                <data android:host="download.archiveofourown.org" />

                <!--
                    Only the paths that name a work. Claiming /collections or
                    /users wholesale would take links to listings the app
                    cannot show, and an app that opens and then says it cannot
                    help is worse than one that never offered.

                    A work inside a collection needs a pattern rather than a
                    prefix for exactly that reason: the work is claimed, the
                    collection's own pages are left alone.
                -->
                <data android:pathPrefix="/works" />
                <data android:pathPrefix="/chapters" />
                <data android:pathPrefix="/series" />
                <data android:pathPrefix="/downloads" />
                <data android:pathPattern="/collections/.*/works/.*" />
            </intent-filter>

            <!--
                Sharing a link into the app. This needs no verification and
                works everywhere, so it is the reliable route: share from the
                browser, pick Fan Folio, and the work is fetched.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
