<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.fanfolio"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- syncing from AO3, and fonts for the reader -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup is off deliberately: a detailed record of what someone
         reads is not something to hand to cloud backup without asking. -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Opening a work link.

                Not autoVerify: verification needs a Digital Asset Links file
                served from the archive's own domain, which is not ours to
                publish. Android therefore treats these as unverified links,
                which on Android 12 and later means the app is not offered
                until the reader turns it on in Settings → Apps → Open by
                default. That is the honest arrangement for a third-party
                reader, and the app says so on its first run.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="archiveofourown.org"
                      android:pathPrefix="/works" />
                <data android:scheme="https" android:host="www.archiveofourown.org"
                      android:pathPrefix="/works" />
                <data android:scheme="http" android:host="archiveofourown.org"
                      android:pathPrefix="/works" />
            </intent-filter>

            <!--
                Sharing a link into the app. This needs no verification and
                works everywhere, so it is the reliable route: share from the
                browser, pick Fan Folio, and the work is fetched.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
